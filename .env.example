# Configuration JobbingTrack Microservices
#
# Alignement avec ton .env local (sans écraser .env) :
#   make env-check
# Générer un fichier d’ajouts suggérés depuis cet exemple :
#   make env-append-missing   → .env.append-from-example.txt (script : scripts/env-align-with-example.cjs)

# ============================================
# PORTS - Configuration centralisée (séquence 5000-5019)
# ============================================
# Ports externes exposés sur l'hôte (alignés avec docker-compose)
# Infra       : 5000-5001
# Gateway/FE  : 5002-5003 (API 5002, Backoffice 5003)
# Monitoring  : 5004, 5098 (hôte) → 8015 (monitoring-c), 5099 (hôte) → 3019 (log-collector-c dans le conteneur)
# Services    : 5005-5019

POSTGRES_PORT=5000
REDIS_PORT=5001
API_GATEWAY_PORT=5002
FRONTEND_PORT=5003
METRICS_AGGREGATOR_PORT=5004
AUTH_SERVICE_PORT=5005
APPLICATION_SERVICE_PORT=5006
COMPANY_SERVICE_PORT=5007
CONTACT_SERVICE_PORT=5008
INTERVIEW_SERVICE_PORT=5009
CALL_SERVICE_PORT=5010
EVENT_SERVICE_PORT=5011
FOLLOWUP_SERVICE_PORT=5012
PROFILE_SERVICE_PORT=5013
NOTIFICATION_SERVICE_PORT=5014
DASHBOARD_SERVICE_PORT=5015
WORKFLOW_SERVICE_PORT=5016
SECURITY_SERVICE_PORT=5017
DEPLOYMENT_SERVICE_PORT=5018
FLUTTER_MOBILE_PORT=5019
MONITORING_C_PORT=5098
LOG_COLLECTOR_C_PORT=5099
# Écoute HTTP du binaire log-collector-c **dans** le conteneur (30xx, comme les services Node)
LOG_COLLECTOR_C_INTERNAL_PORT=3019
MAILHOG_PORT=8025

# Ports internes (dans les conteneurs Docker)
POSTGRES_INTERNAL_PORT=5432
REDIS_INTERNAL_PORT=6379
FRONTEND_INTERNAL_PORT=3000
API_GATEWAY_INTERNAL_PORT=3000
AUTH_SERVICE_INTERNAL_PORT=3001
APPLICATION_SERVICE_INTERNAL_PORT=3002
COMPANY_SERVICE_INTERNAL_PORT=3003
CONTACT_SERVICE_INTERNAL_PORT=3004
INTERVIEW_SERVICE_INTERNAL_PORT=3005
CALL_SERVICE_INTERNAL_PORT=3008
EVENT_SERVICE_INTERNAL_PORT=3011
FOLLOWUP_SERVICE_INTERNAL_PORT=3012
PROFILE_SERVICE_INTERNAL_PORT=3009
NOTIFICATION_SERVICE_INTERNAL_PORT=3008
DASHBOARD_SERVICE_INTERNAL_PORT=3000
WORKFLOW_SERVICE_INTERNAL_PORT=3013
SECURITY_SERVICE_INTERNAL_PORT=3017
DEPLOYMENT_SERVICE_INTERNAL_PORT=3016
METRICS_AGGREGATOR_INTERNAL_PORT=3014
# monitoring-c : 8015 (binaire C, pas 30xx). log-collector-c : 3019.
FLUTTER_MOBILE_INTERNAL_PORT=8080

# URLs Frontend (pour le client - utilisez les ports externes ci-dessus)
NEXT_PUBLIC_API_URL=http://localhost:5002
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:5005
NEXT_PUBLIC_METRICS_URL=http://localhost:5004
NEXT_PUBLIC_METRICS_AGGREGATOR_URL=http://localhost:5004
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5003
# Fuseau IANA pour les dates / graphiques analytics (prioritaire sur le fuseau annoncé par Intl). Si le navigateur affiche « Atlantic/Reykjavik » ou « Iceland » (= UTC), le front utilise Europe/Paris sans cette variable ; tu peux quand même forcer un fuseau explicite (ex. prod multi-régions).
NEXT_PUBLIC_CHART_TIMEZONE=Europe/Paris
# Alias souvent déjà défini dans docker-compose pour le conteneur frontend : NEXT_PUBLIC_TZ
# Contrôleur émulateur (backoffice mobile-emulator) : en Docker, mettre l’IP de l’hôte si host.docker.internal indisponible (ex. Linux) ;127.0.0.1 évite soucis IPv6 ; en Docker frontend : http://host.docker.internal:5055
EMULATOR_CONTROLLER_URL=http://127.0.0.1:5055

# URLs Services (pour communication inter-conteneurs Docker)
AUTH_SERVICE_URL=http://auth-service:3001
APPLICATION_SERVICE_URL=http://application-service:3002
COMPANY_SERVICE_URL=http://company-service:3003
CONTACT_SERVICE_URL=http://contact-service:3004
INTERVIEW_SERVICE_URL=http://interview-service:3005
CALL_SERVICE_URL=http://call-service:3008
EVENT_SERVICE_URL=http://event-service:3011
FOLLOWUP_SERVICE_URL=http://followup-service:3012
METRICS_AGGREGATOR_URL=http://metrics-aggregator:3014
DASHBOARD_SERVICE_URL=http://dashboard-service:3000
API_GATEWAY_URL=http://api-gateway:3000
# Nombre de proxies devant l'API Gateway (LB / ingress). Défaut 1. Évite trust proxy « true » (rejet express-rate-limit v7).
TRUST_PROXY_HOPS=1
# Monitoring / log collector (inter-conteneurs)
MONITORING_C_URL=http://monitoring-c:8015
LOG_COLLECTOR_C_URL=http://log-collector-c:3019

# ============================================
# BASE DE DONNÉES
# ============================================
# Host localhost + POSTGRES_PORT mappé Docker (5000:5432)
DATABASE_URL=postgresql://jobbingtrack:jobbingtrack123@localhost:5000/jobbingtrack?schema=public
POSTGRES_USER=jobbingtrack
POSTGRES_PASSWORD=jobbingtrack123
POSTGRES_DB=jobbingtrack
POSTGRES_HOST=postgres
# Session PostgreSQL pour colonnes TIMESTAMP sans fuseau (ex. public.system_metrics, NOW() via monitoring-c).
# Garder UTC : horloge « mur » UTC dans la colonne naïve ; l’affichage utilisateur = fuseau du navigateur (Intl).
# Ne pas passer à Europe/Paris sans migration : le SQL `AT TIME ZONE` de l’agrégateur suit cette variable.
POSTGRES_SYSTEM_METRICS_TZ=UTC
# Fuseau du conteneur frontend (Next) pour logs / rendu serveur ; indépendant des graphiques client (navigateur).
# TZ=Europe/Paris

# ============================================
# CONFIGURATION ADMIN
# ============================================
ADMIN_EMAIL=admin@jobbingtrack.com
ADMIN_PASSWORD=password123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=JobbingTrack
# Emails jamais supprimés par make datas-remove-tests-tags / clear-test-data (séparés par des virgules)
# PROTECTED_USER_EMAILS=autre-admin@example.com

# ============================================
# JWT
# ============================================
JWT_SECRET=your-secret-key-change-in-production-2025
JWT_REFRESH_SECRET=your-refresh-secret-change-too-2025
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
# Secret partagé : appels machine vers security-service (routes /firewall, /waf) + scripts `security-live-check` / `test-firewall` en direct sur le port 5017. Doit être identique sur api-gateway, auth-service et security-service.
SECURITY_INTERNAL_SECRET=jobbingtrack-internal-security-dev

# API Gateway — détection d’intrusion (Redis + envois vers security-service). Désactiver : false
# Ignoré automatiquement si NODE_ENV=test (Jest) ou User-Agent Playwright ou X-Test-Mode: true
INTRUSION_DETECTION_ENABLED=true

# ============================================
# API GATEWAY
# ============================================
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5003,http://localhost:5002,http://localhost:5173

# ============================================
# ============================================================================
# CONFIGURATION EMAIL (SMTP OVH)
# ============================================================================
# À finaliser avant envoi réel (préprod/prod) — détail : docs/operations/PREPROD_PRODUCTION_CHECKLIST.md § F
# - SMTP_USER / SMTP_PASS : identifiants réels du fournisseur (ne pas committer le .env rempli)
# - Port + SMTP_SECURE + SMTP_USE_SSL : suivre la doc du fournisseur (ex. 465 SSL vs 587 STARTTLS)
# - CRASH_REPORT_EMAIL : boîte dédiée aux rapports crash (filtrage, monitoring), pas une adresse « jetable » sans processus
# Configuration SMTP OVH pour jobbingtrack.com
# Pour la production, utilisez votre compte OVH
SMTP_HOST=xxx0.xxx.xxx
SMTP_PORT=465
SMTP_USER=noreply@company.com
SMTP_PASS=XxxxXxxXxXxxxx
# Si format "Nom <email>", mettre entre guillemets pour éviter erreur shell au source
SMTP_FROM=noreply@company.com
# SMTP_FROM="JobbingTrack <noreply@jobbingtrack.com>"
SMTP_REPLY_TO=noreply@company.com
SMTP_SECURE=false
SMTP_USE_SSL=true

# Email de destination des rapports de crash (app mobile / frontend)
# En dev avec MailHog : utiliser une adresse test (ex. crash@test.local) ; les emails sont visibles dans MailHog (http://localhost:8025)
# En prod : 
CRASH_REPORT_EMAIL=reports@company.com
EMAIL_PROVIDER=SMTP
# Resend (optionnel) : API emails, tier gratuit dispo. À configurer plus tard si besoin. Laisser vide pour éviter le warning Docker Compose.
RESEND_API_KEY=

# URLs pour les liens dans les emails (IMPORTANT)
# En développement : http://localhost:5003 (backoffice)
# En production : https://app.jobbingtrack.com
FRONTEND_URL=http://localhost:5003
# Si les liens dans les emails doivent être ouverts depuis un autre appareil (ex. téléphone),
# définir HOST_IP avec l’IP de la machine (ex. 192.168.1.10). Les liens remplaceront localhost par cette IP.
BACKEND_URL=http://localhost:5002

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:5001
# Utilisé par docker-compose (ex. api-gateway) pour le hostname Redis sur le réseau interne
REDIS_HOST=redis

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# METRICS AGGREGATOR (authentification)
# ============================================
# Activer l'auth sur /api/v1/metrics (sinon accès libre, log une seule fois au démarrage)
# ENABLE_METRICS_AUTH=true
# Clé pour appels server-to-server (X-API-Key). En prod, le backoffice envoie le Bearer JWT.
# METRICS_API_KEY=your-secret-key-in-production

# ============================================
# MONITORING STACK (Prometheus + Loki + cAdvisor)
# ============================================
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# ============================================
# RÉTENTION DES DONNÉES
# ============================================
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=50GB
LOKI_RETENTION_DAYS=30

# IP de la machine pour accès réseau local
HOST_IP=YOUR_LOCAL_IP_ADDRESS

# ============================================
# TESTS — Credentials (ne pas committer les vraies valeurs)
# ============================================
# Compte email réel pour vérifier la réception des mails dans les tests
TEST_REAL_EMAIL=test@example.com
TEST_REAL_EMAIL_PASSWORD=
TEST_REAL_EMAIL_IMAP_HOST=imap.example.com
TEST_REAL_EMAIL_IMAP_PORT=993

# Compte de test principal (user1) — génération de données + parcours mobile.
# Si défini avec une adresse qui reçoit les mails (ex. Proton, alias), inscription / reset mot de passe envoient les mails à cette adresse.
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123

# Même compte côté frontend (émulateur mobile, étapes fill_login_form_user1, inscription, reset).
# À aligner avec TEST_USER_EMAIL/TEST_USER_PASSWORD pour que les parcours utilisent le bon compte.
NEXT_PUBLIC_MOBILE_TEST_USER_EMAIL=test@example.com
NEXT_PUBLIC_MOBILE_TEST_USER_PASSWORD=password123

# Credentials tests : admin (Playwright, backoffice)
TEST_ADMIN_EMAIL=admin@company.com
TEST_ADMIN_PASSWORD=password123


# ============================================
# OPTIONS DÉVELOPPEMENT
# ============================================
ENABLE_TIME_TRAVEL=true

# Playwright (make test-all) : ignorer les tests login UI lents ou instables (login API reste teste dans api-e2e.spec.ts)
# E2E_SKIP_LOGIN_UI=1

# Lancer la suite mobile Playwright meme sans appareil adb en etat device (sinon detection automatique adb)
# RUN_PLAYWRIGHT_MOBILE=1
# PLAYWRIGHT_MOBILE_PROJECT=iPhone 13 Pro

# --- Après changement de fuseau / .env (monitoring) ---
# Recréer postgres + collecteur C + agrégateur pour appliquer les variables (volumes BDD conservés) :
#   make monitoring-clock-refresh
# Si l’image metrics-aggregator doit être reconstruite (pas de bind-mount du src) :
#   REBUILD_METRICS=1 make monitoring-clock-refresh
