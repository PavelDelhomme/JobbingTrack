{
  "name": "jobbingtrack-tests",
  "version": "1.0.0",
  "description": "Tests complets pour JobbingTrack",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:database && npm run test:api && npm run test:e2e",
    "test:unit": "jest unit/",
    "test:integration": "jest integration/",
    "test:database": "node database/test-database.js",
    "test:api": "jest api/",
    "test:e2e": "playwright test e2e/",
    "test:backend": "jest backend/",
    "test:frontend": "jest frontend/",
    "test:mobile": "jest mobile/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:playwright": "playwright test --headed",
    "test:playwright:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "axios": "^1.6.0",
    "playwright": "^1.40.0",
    "pg": "^8.11.0",
    "docker-compose": "^0.24.0",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-jest": "^27.6.0"
  }
}
