{
  "name": "jobbingtrack-metrics-aggregator-api",
  "version": "1.0.1",
  "description": "API sécurisée pour exposer les métriques JobbingTrack et logs agrégés",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/*.test.js",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "metrics",
    "monitoring",
    "monitoring-agent-rs",
    "log-collector-rs",
    "api"
  ],
  "author": "JobbingTrack Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.7.0",
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.0",
    "express": "^4.22.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2",
    "socket.io": "^4.6.1",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "6.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
