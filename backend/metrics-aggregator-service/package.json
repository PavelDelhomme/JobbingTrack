{
  "name": "jobbingtrack-metrics-aggregator-api",
  "version": "1.0.0",
  "description": "API sécurisée pour exposer les métriques Prometheus et logs Loki",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
