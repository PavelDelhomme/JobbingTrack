// ============================================
// SCHÉMA PRISMA PARTAGÉ - JobbingTrack
// ============================================
// Ce schéma unique est utilisé par TOUS les services
// Il n'y a qu'UNE SEULE base de données PostgreSQL
// Pas de duplication, toutes les relations sont réelles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 👤 UTILISATEURS & AUTHENTIFICATION
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  profilePicture    String?
  
  // Authentification
  authToken         String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  verificationToken String?   @unique
  verificationTokenExpiry DateTime?
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  
  // Rôle et statut
  role              UserRole  @default(USER)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  loginCount        Int       @default(0)
  
  // Préférences
  theme             String?   @default("light")
  language          String?   @default("fr")
  timezone          String?   @default("Europe/Paris")
  notificationsEnabled Boolean @default(true)

  // Données de test (filtre données test cohérent)
  isTestData Boolean @default(false)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete
  
  // Relations
  profile           Profile?
  applications      Application[]
  companies         Company[]
  contacts          Contact[]
  followUps         FollowUp[]
  calls             Call[]
  interviews        Interview[]
  events            Event[]
  notifications     Notification[]
  documents         Document[]
  syncQueue         SyncQueue[]
  emailLogs         EmailLog[]          // Logs des emails envoyés
  
  // Relations Analytics & Tracking
  sessions          UserSession[]
  userEvents        UserEvent[]
  userErrors        UserError[]
  userPerformances  UserPerformance[]
  devices           DeviceInfo[]
  
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([isTestData])
}

// ============================================
// 👤 PROFIL UTILISATEUR (lié à User)
// ============================================

model Profile {
  id           String  @id @default(cuid())
  userId       String  @unique
  bio          String?
  headline     String?
  avatarUrl    String?
  linkedinUrl  String?
  githubUrl    String?
  website      String?
  preferences  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  TESTER
}

// ============================================
// 🏢 ENTREPRISES
// ============================================

model Company {
  id                String    @id @default(cuid())
  userId            String
  name              String
  website           String?
  industry          String?   // Secteur d'activité
  size              CompanySize?
  companyType       CompanyType            @default(EMPLOYER) // EMPLOYER = entreprise classique, TEMP_AGENCY = boîte d'intérim
  location          String?
  address           String?
  city              String?
  postalCode        String?
  country           String?   @default("France")
  logoUrl           String?
  description       String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  
  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications      Application[]      // Candidatures où cette company est l'employeur (entreprise utilisatrice)
  applicationsViaAgency Application[]  @relation("AgencyApplications") // Candidatures/propositions passées par cette boîte d'intérim
  contacts          ContactCompany[]  // Many-to-many
  followUps         FollowUp[]
  calls             Call[]
  interviews        Interview[]
  
  @@index([userId])
  @@index([name])
  @@index([companyType])
}

enum CompanyType {
  EMPLOYER           // Entreprise employeuse classique (recherche directe)
  TEMP_AGENCY        // Boîte d'intérim (propositions / missions via l'agence)
}

enum CompanySize {
  STARTUP           // < 10
  SMALL             // 10-50
  MEDIUM            // 50-250
  LARGE             // 250-1000
  ENTERPRISE        // > 1000
}

// ============================================
// 📄 CANDIDATURES
// ============================================

model Application {
  id                    String              @id @default(cuid())
  userId                String
  companyId             String              // Entreprise employeuse (client final ou agence si candidature directe agence)
  agencyId              String?             // Optionnel : boîte d'intérim à l'origine de la proposition/mission
  platformId            String?             // Plateforme de candidature (personnalisable)
  
  // Informations de l'offre
  position              String              // Intitulé du poste
  description           String?             // Description du poste
  jobUrl                String?             // URL de l'offre
  location              String?             // Lieu du poste
  contractType          ContractType        @default(CDI)
  workMode              WorkMode?           // Présentiel/Distanciel/Hybride
  
  // Candidature
  applicationDate       DateTime            @default(now())
  applicationType       ApplicationType     @default(OFFRE) // Spontanée ou à une offre
  statusId              String              // Relation vers ApplicationStatus (BDD)
  
  // Rémunération
  salaryMin             Int?                // en euros/an
  salaryMax             Int?                // en euros/an
  salaryNegotiable      Boolean             @default(false)
  
  // Notes et suivi (colonne BDD : archived)
  notes                 String?
  isArchived            Boolean             @default(false) @map("archived")
  archivedAt            DateTime?
  statusEngineOptOut    Boolean             @default(false)
  
  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  
  // Relations
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  company               Company             @relation(fields: [companyId], references: [id])
  agency                Company?            @relation("AgencyApplications", fields: [agencyId], references: [id])
  platform              Platform?           @relation(fields: [platformId], references: [id])
  status                ApplicationStatus   @relation(fields: [statusId], references: [id])
  
  contacts              ContactApplication[] // Many-to-many
  followUps             FollowUp[]
  calls                 Call[]
  interviews            Interview[]
  events                Event[]
  documents             Document[]
  statusHistory         ApplicationStatusHistory[]
  
  @@index([userId])
  @@index([companyId])
  @@index([agencyId])
  @@index([statusId])
  @@index([applicationDate])
}

enum ContractType {
  CDI                   // Contrat à Durée Indéterminée
  CDD                   // Contrat à Durée Déterminée
  ALTERNANCE            // Alternance
  STAGE                 // Stage
  FREELANCE             // Freelance
  INTERIM               // Intérim
  SAISONNIER            // Saisonnier
}

enum WorkMode {
  ON_SITE               // Présentiel
  REMOTE                // Distanciel
  HYBRID                // Hybride
}

enum ApplicationType {
  OFFRE                 // Candidature à une offre
  SPONTANEE             // Candidature spontanée
}

// Table ApplicationStatus (aligné BDD – statusId sur Application)
model ApplicationStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  order       Int
  color       String?
  icon        String?
  userId      String?
  isPredefined Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  applications            Application[]
  previousStatusHistories ApplicationStatusHistory[] @relation("PreviousStatus")
  newStatusHistories      ApplicationStatusHistory[] @relation("NewStatus")
  @@index([code])
}

// ============================================
// 👥 CONTACTS
// ============================================

model Contact {
  id                String              @id @default(cuid())
  userId            String
  firstName         String
  lastName          String
  position          String?             // Fonction
  email             String?
  phone             String?
  linkedinUrl       String?
  notes             String?
  
  // Champs d'archivage
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  archivedReason    String?
  
  // Données de test et sync (filtre données test cohérent)
  isTestData        Boolean             @default(false)
  syncHash          String?
  entityHash        String?
  lastSyncAt        DateTime?
  
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companies         ContactCompany[]        // Many-to-many avec Company
  applications      ContactApplication[]    // Many-to-many avec Application
  followUps         FollowUpContact[]       // Many-to-many avec FollowUp
  interviews        InterviewContact[]      // Many-to-many avec Interview
  calls             Call[]                  // One-to-many
  
  @@index([userId])
  @@index([email])
  @@index([lastName, firstName])
  @@index([isTestData])
}

// ============================================
// 🔄 RELANCES (FollowUps)
// ============================================

model FollowUp {
  id                String              @id @default(cuid())
  userId            String
  applicationId     String
  companyId         String
  followUpTypeId    String?
  followUpMethodId  String?
  
  followUpDate      DateTime
  statusId          String              // Relation vers FollowUpStatus (table *Status)
  response          String?
  notes             String?
  
  // Données de test et sync
  isTestData        Boolean             @default(false)
  syncHash          String?
  entityHash        String?
  lastSyncAt        DateTime?
  
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company           Company             @relation(fields: [companyId], references: [id])
  followUpType      FollowUpType?       @relation(fields: [followUpTypeId], references: [id])
  followUpMethod    FollowUpMethod?     @relation(fields: [followUpMethodId], references: [id])
  status            FollowUpStatus      @relation(fields: [statusId], references: [id])
  
  contacts          FollowUpContact[]   // Many-to-many
  calls             Call[]
  events            Event[]
  
  @@index([userId])
  @@index([applicationId])
  @@index([statusId])
  @@index([followUpDate])
  @@index([isTestData])
}

// Table FollowUpStatus (statuts personnalisables, aligné BDD)
model FollowUpStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  order       Int
  color       String?
  icon        String?
  userId      String?
  isPredefined Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  followUps   FollowUp[]
  @@index([code])
}

// ============================================
// 📞 APPELS
// ============================================

model Call {
  id                String              @id @default(cuid())
  userId            String
  applicationId     String?
  companyId         String?
  followUpId        String?
  contactId         String?
  callTypeId        String?             // Type d'appel (personnalisable)
  
  // Informations de l'appel
  callDate          DateTime
  duration          Int?                // Durée en minutes
  subject           String              // Objet de l'appel
  notes             String?
  status            CallStatus          @default(COMPLETED)
  
  // Données de test et sync
  isTestData        Boolean             @default(false)
  syncHash          String?
  entityHash        String?
  lastSyncAt        DateTime?
  
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  followUp          FollowUp?           @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  contact           Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  callType          CallType?           @relation(fields: [callTypeId], references: [id])
  
  events            Event[]
  
  @@index([userId])
  @@index([callDate])
  @@index([status])
  @@index([isTestData])
}

enum CallStatus {
  SCHEDULED                 // Programmé
  COMPLETED                 // Effectué
  MISSED                    // Manqué
  CANCELLED                 // Annulé
}

// ============================================
// 💼 ENTRETIENS
// ============================================

model Interview {
  id                    String              @id @default(cuid())
  userId                String
  applicationId         String
  companyId             String
  interviewTypeId       String?             // Type d'entretien (personnalisable)
  interviewStyleId      String?             // Style d'entretien (personnalisable)
  
  // Informations de l'entretien
  interviewDate         DateTime
  estimatedDuration     Int?                // Durée estimée en minutes
  location              String?             // Lieu physique
  videoLink             String?             // Lien visio
  statusId              String              // Relation vers InterviewStatus (BDD)
  
  // Retour attendu
  feedbackExpectedFrom  DateTime?           // Début plage de retour
  feedbackExpectedTo    DateTime?           // Fin plage de retour
  feedbackReceived      Boolean             @default(false)
  
  // Résultat
  outcome               InterviewOutcome?
  notes                 String?
  
  // Données de test et sync
  isTestData            Boolean             @default(false)
  syncHash              String?
  entityHash            String?
  lastSyncAt            DateTime?
  
  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  
  // Relations
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application           Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company               Company             @relation(fields: [companyId], references: [id])
  interviewType         InterviewType?      @relation(fields: [interviewTypeId], references: [id])
  interviewStyle        InterviewStyle?     @relation(fields: [interviewStyleId], references: [id])
  status                InterviewStatus     @relation(fields: [statusId], references: [id])
  
  contacts              InterviewContact[]  // Many-to-many
  events                Event[]
  
  @@index([userId])
  @@index([applicationId])
  @@index([statusId])
  @@index([interviewDate])
  @@index([isTestData])
}

// Table InterviewStatus (aligné BDD – statusId sur Interview)
model InterviewStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  order       Int
  color       String?
  icon        String?
  userId      String?
  isPredefined Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  interviews  Interview[]
  @@index([code])
}

enum InterviewOutcome {
  POSITIVE                  // Retour positif
  NEGATIVE                  // Retour négatif
  NEUTRAL                   // Neutre
  PENDING                   // En attente
}

// ============================================
// 📅 ÉVÉNEMENTS / CALENDRIER
// ============================================

model Event {
  id                String              @id @default(cuid())
  userId            String
  eventTypeId       String?             // Type d'événement (personnalisable)
  
  // Informations de l'événement
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  allDay            Boolean             @default(false)
  
  // Lien polymorphe (un seul lien actif)
  applicationId     String?
  interviewId       String?
  followUpId        String?
  callId            String?
  
  // Rappels
  reminderEnabled   Boolean             @default(false)
  reminderMinutes   Int?                // Minutes avant l'événement
  
  // Personnalisation
  color             String?             @default("#3B82F6")
  
  // Données de test
  isTestData        Boolean             @default(false)
  
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType         EventType?          @relation(fields: [eventTypeId], references: [id])
  
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview         Interview?          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  followUp          FollowUp?           @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  call              Call?               @relation(fields: [callId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([startDate])
  @@index([applicationId])
  @@index([interviewId])
  @@index([isTestData])
}

// ============================================
// 📝 HISTORIQUE DES STATUS
// ============================================

model ApplicationStatusHistory {
  id                String              @id @default(cuid())
  applicationId     String
  previousStatusId  String?
  newStatusId       String
  comment           String?
  changedAt         DateTime            @default(now())
  
  application       Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus    ApplicationStatus?   @relation("PreviousStatus", fields: [previousStatusId], references: [id])
  newStatus         ApplicationStatus   @relation("NewStatus", fields: [newStatusId], references: [id])
  
  @@index([applicationId])
  @@index([changedAt])
}

// ============================================
// 📎 DOCUMENTS
// ============================================

model Document {
  id                String              @id @default(cuid())
  userId            String
  applicationId     String?
  
  // Informations du document
  name              String
  documentType      DocumentType
  fileUrl           String
  fileSize          Int                 // en bytes
  mimeType          String
  
  // Données de test et sync
  isTestData        Boolean             @default(false)
  syncHash          String?
  entityHash        String?
  lastSyncAt        DateTime?
  
  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([applicationId])
  @@index([documentType])
  @@index([isTestData])
}

enum DocumentType {
  CV
  COVER_LETTER              // Lettre de motivation
  PORTFOLIO
  CERTIFICATE               // Certificat
  DIPLOMA                   // Diplôme
  RECOMMENDATION            // Lettre de recommandation
  OTHER
}

// ============================================
// 🔔 NOTIFICATIONS
// ============================================

model Notification {
  id                String              @id @default(cuid())
  userId            String
  
  // Contenu
  title             String
  message           String
  type              NotificationType
  
  // État
  read              Boolean             @default(false)
  readAt            DateTime?
  
  // Lien vers entité
  entityType        String?             // Application, Interview, etc.
  entityId          String?
  data              Json?               // Données supplémentaires
  
  // Timestamps
  createdAt         DateTime            @default(now())
  
  // Relation
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  REMINDER
  APPLICATION_UPDATE
  INTERVIEW_SCHEDULED
  FOLLOWUP_DUE
  DEADLINE
  SYSTEM
  CRASH_REPORT
  ERROR_REPORT
  STATUS_CHANGE
}

// ============================================
// 🔄 QUEUE DE SYNCHRONISATION (Offline)
// ============================================

model SyncQueue {
  id                String              @id @default(cuid())
  userId            String
  
  // Action
  action            SyncAction
  entity            String              // Application, Interview, etc.
  entityId          String?
  payload           Json
  
  // État
  synced            Boolean             @default(false)
  attempts          Int                 @default(0)
  lastAttempt       DateTime?
  error             String?
  
  // Timestamps
  createdAt         DateTime            @default(now())
  syncedAt          DateTime?
  
  // Relation
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([synced])
  @@index([createdAt])
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

// ============================================
// 🔗 TABLES DE JONCTION (Many-to-Many)
// ============================================

model ContactCompany {
  id                String              @id @default(cuid())
  contactId         String
  companyId         String
  createdAt         DateTime            @default(now())
  
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@unique([contactId, companyId])
  @@index([contactId])
  @@index([companyId])
}

model ContactApplication {
  id                String              @id @default(cuid())
  contactId         String
  applicationId     String
  createdAt         DateTime            @default(now())
  
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  application       Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([contactId, applicationId])
  @@index([contactId])
  @@index([applicationId])
}

model FollowUpContact {
  id                String              @id @default(cuid())
  followUpId        String
  contactId         String
  createdAt         DateTime            @default(now())
  
  followUp          FollowUp            @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  @@unique([followUpId, contactId])
  @@index([followUpId])
  @@index([contactId])
}

model InterviewContact {
  id                String              @id @default(cuid())
  interviewId       String
  contactId         String
  createdAt         DateTime            @default(now())
  
  interview         Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  contact           Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  @@unique([interviewId, contactId])
  @@index([interviewId])
  @@index([contactId])
}

// ============================================
// 🎨 LISTES PERSONNALISABLES PAR L'UTILISATEUR
// ============================================

// Plateformes de candidature (LinkedIn, Indeed, etc.)
model Platform {
  id                String              @id @default(cuid())
  userId            String?             // null = plateforme par défaut système
  name              String
  icon              String?
  url               String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  applications      Application[]
  
  @@unique([userId, name])
  @@index([userId])
}

// Types de relance (Email, Téléphone, LinkedIn, etc.)
model FollowUpType {
  id                String              @id @default(cuid())
  userId            String?
  name              String
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  followUps         FollowUp[]
  
  @@unique([userId, name])
  @@index([userId])
}

// Moyens de relance (Email, Téléphone, Message, etc.)
model FollowUpMethod {
  id                String              @id @default(cuid())
  userId            String?
  name              String
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  followUps         FollowUp[]
  
  @@unique([userId, name])
  @@index([userId])
}

// Types d'entretien (RH, Technique, Manager, etc.)
model InterviewType {
  id                String              @id @default(cuid())
  userId            String?
  name              String
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  interviews        Interview[]
  
  @@unique([userId, name])
  @@index([userId])
}

// Styles d'entretien (Présentiel, Distanciel, Hybride)
model InterviewStyle {
  id                String              @id @default(cuid())
  userId            String?
  name              String
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  interviews        Interview[]
  
  @@unique([userId, name])
  @@index([userId])
}

// Types d'événement (Entretien, Relance, Deadline, etc.)
model EventType {
  id                String              @id @default(cuid())
  userId            String?
  code              String?
  name              String
  color             String?
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  events            Event[]
  
  @@unique([userId, name])
  @@index([userId])
  @@index([code])
}

// Types d'appel (Sortant, Entrant, Manqué, etc.)
model CallType {
  id                String              @id @default(cuid())
  userId            String?
  name              String
  icon              String?
  isPredefined      Boolean             @default(false)
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  calls             Call[]
  
  @@unique([userId, name])
  @@index([userId])
}

// ============================================
// 📊 LOGS & MONITORING
// ============================================

// Logs des conteneurs Docker (pour metrics-aggregator)
model ContainerLog {
  id                String              @id @default(cuid())
  containerId       String              // ID Docker du conteneur
  containerName     String              // Nom du conteneur (ex: jobbingtrack-api-gateway)
  level             String              @default("info") // debug, info, warn, error
  message           String              @db.Text
  timestamp         DateTime            @default(now())
  metadata          Json?               // Données additionnelles (stack trace, contexte, etc.)
  
  @@index([containerName, timestamp])
  @@index([level, timestamp])
  @@index([timestamp])
}

// ============================================
// 📧 EMAILS
// ============================================

// Logs de tous les emails envoyés
model EmailLog {
  id                String              @id @default(cuid())
  userId            String?             // Utilisateur concerné (peut être null pour emails système)
  to                String              // Destinataire
  from              String              // Expéditeur
  subject           String              // Sujet
  type              EmailType           // Type d'email
  status            EmailStatus         @default(PENDING) // Statut d'envoi
  sentAt            DateTime?           // Date d'envoi réussi
  deliveredAt       DateTime?           // Date de livraison (si webhook disponible)
  openedAt          DateTime?           // Date d'ouverture (pixel de tracking)
  clickedAt         DateTime?           // Date de clic sur un lien
  error             String?             @db.Text // Message d'erreur si échec
  emailContent      String?             @db.Text // Contenu HTML de l'email
  metadata          Json?               // Métadonnées additionnelles (resetToken, verificationUrl, etc.)
  trackingId        String?             @unique // ID unique pour le tracking (pixel de tracking)
  openCount         Int                 @default(0) // Nombre de fois que l'email a été ouvert
  clickCount        Int                 @default(0) // Nombre de clics sur les liens
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([to])
  @@index([type])
  @@index([status])
  @@index([sentAt])
  @@index([createdAt])
  @@index([trackingId])
}

enum EmailType {
  WELCOME
  VERIFICATION
  RESET_PASSWORD
  CONFIRMATION
  NOTIFICATION
  TEST
}

enum EmailStatus {
  PENDING      // En attente d'envoi
  SENT         // Envoyé avec succès au serveur SMTP
  DELIVERED    // Livré dans la boîte mail du destinataire (si webhook disponible)
  READ         // Lu par le destinataire (si tracking disponible)
  FAILED       // Échec d'envoi
  BOUNCED      // Email rejeté par le serveur destinataire
}

// Templates d'emails personnalisables
model EmailTemplate {
  id          String    @id @default(cuid())
  type        EmailType @unique // WELCOME, VERIFICATION, RESET_PASSWORD, etc.
  name        String    // Nom du template
  subject     String    // Sujet de l'email (peut contenir des variables {{variableName}})
  htmlContent String    @db.Text // Contenu HTML du template
  textContent String?   @db.Text // Contenu texte du template (optionnel)
  variables   String[]  // Variables détectées automatiquement (ex: ["firstName", "lastName", "resetUrl"])
  isActive    Boolean   @default(true) // Si le template est actif (utilisé) ou non
  version     Int       @default(1) // Version du template pour tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([type])
  @@index([isActive])
}

// ============================================
// ⚙️ PRÉFÉRENCES UTILISATEUR
// ============================================

model UserCustomization {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  Json     // Préférences utilisateur (refreshInterval, display, notifications, etc.)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

// ============================================
// 📊 TRACKING & ANALYTICS UTILISATEUR
// ============================================

// Sessions utilisateur (web et mobile)
model UserSession {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String   @unique
  deviceId        String?  // Identifiant unique de l'appareil
  platform        String   // "web", "ios", "android"
  userAgent       String?
  ipAddress       String?
  
  // Informations appareil
  deviceModel     String?  // iPhone 13, Samsung Galaxy S21, etc.
  osName          String?  // iOS, Android, Windows, macOS, Linux
  osVersion       String?  // 15.0, 12, etc.
  browserName     String?  // Chrome, Safari, Firefox, etc.
  browserVersion  String?  // 120.0, etc.
  screenWidth     Int?
  screenHeight    Int?
  language        String?  // fr, en, etc.
  timezone        String?  // Europe/Paris, etc.
  
  // Métadonnées session
  startTime       DateTime @default(now())
  endTime         DateTime?
  duration        Int?     // secondes
  isActive        Boolean  @default(true)
  pageViews       Int      @default(0)
  actions         Int      @default(0)
  errors          Int      @default(0)
  
  // Relations
  events          UserEvent[]
  userErrors      UserError[]
  performances    UserPerformance[]
  
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([startTime])
  @@index([platform])
  @@index([isActive])
  @@map("user_sessions")
}

// Événements utilisateur (clics, navigation, etc.)
model UserEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String
  deviceId    String?
  
  // Type d'événement
  eventType   String   // "click", "navigation", "form_submit", "notification_received", etc.
  eventName   String   // "button_click", "page_view", "notification_relance", etc.
  category    String?  // "ui", "navigation", "notification", "form", etc.
  
  // Détails
  elementId   String?  // ID de l'élément cliqué
  elementType String?  // "button", "link", "input", etc.
  elementText String?  // Texte de l'élément
  page        String?  // URL ou nom de la page
  properties  Json?    // Propriétés additionnelles
  
  // Contexte
  timestamp   DateTime @default(now())
  platform    String   // "web", "ios", "android"
  appVersion  String?  // Version de l'app
  
  // Relations
  session     UserSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([eventName])
  @@index([timestamp])
  @@index([category])
  @@map("user_events")
}

// Erreurs et logs utilisateur
model UserError {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  deviceId    String?
  
  // Type d'erreur
  errorType   String   // "javascript", "api", "network", "crash", etc.
  errorName   String   // "TypeError", "NetworkError", etc.
  errorMessage String
  stackTrace  String?  // Stack trace (sanitized)
  
  // Contexte
  page        String?  // URL ou nom de la page
  userAgent   String?
  timestamp   DateTime @default(now())
  platform    String   // "web", "ios", "android"
  appVersion  String?
  
  // Métadonnées
  severity    String   @default("error") // "error", "warning", "critical"
  resolved    Boolean  @default(false)
  properties  Json?    // Propriétés additionnelles
  
  // Relations
  session     UserSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@index([errorType])
  @@index([severity])
  @@index([timestamp])
  @@index([resolved])
  @@map("user_errors")
}

// Métriques de performance
model UserPerformance {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String?
  deviceId        String?
  
  // Type de métrique
  metricType      String   // "page_load", "api_call", "render", "memory", "battery", etc.
  metricName      String   // Nom spécifique (ex: "load_applications", "api_get_users")
  
  // Valeurs
  value           Float?   // Valeur principale
  duration        Int?     // Durée en millisecondes
  memoryUsage     Float?   // MB
  cpuUsage        Float?   // pourcentage
  networkLatency  Int?     // ms
  networkType     String?  // "wifi", "4g", "5g", "ethernet"
  
  // Contexte
  page            String?  // URL ou nom de la page
  timestamp       DateTime @default(now())
  platform        String   // "web", "ios", "android"
  appVersion      String?
  
  // Relations
  session         UserSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@index([metricType])
  @@index([metricName])
  @@index([timestamp])
  @@map("user_performances")
}

// Informations appareil (pour tracking mobile)
model DeviceInfo {
  id              String   @id @default(cuid())
  userId          String?
  deviceId        String   @unique
  
  // Informations appareil
  platform        String   // "ios", "android", "web"
  deviceModel     String?  // iPhone 13, Samsung Galaxy S21, etc.
  osName          String?  // iOS, Android
  osVersion       String?  // 15.0, 12, etc.
  appVersion      String?  // Version de l'application
  
  // Informations écran
  screenWidth     Int?
  screenHeight    Int?
  screenDensity   Float?   // DPI
  
  // Informations système
  language        String?
  timezone        String?
  batteryLevel    Int?     // pourcentage
  isCharging      Boolean?
  networkType     String?  // "wifi", "4g", "5g"
  
  // Métadonnées
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  totalSessions   Int      @default(0)
  
  // Relations
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceId])
  @@index([platform])
  @@map("device_infos")
}

