# ═════════════════════════════════════════════════════════════
# Configuration Auth Service - JobbingTrack
# ═════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 🔐 JWT Configuration
# ─────────────────────────────────────────────────────────────
JWT_SECRET=votre_secret_jwt_tres_securise_changez_en_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=votre_refresh_secret_jwt_tres_securise
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────
# 📧 SMTP Configuration (Envoi d'emails)
# ─────────────────────────────────────────────────────────────
# Pour Gmail : utilisez un "App Password" (pas votre mot de passe principal)
# Guide : https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=redacted@example.invalid
SMTP_PASS=votre_app_password_16_caracteres
SMTP_FROM="JobbingTrack <redacted@example.invalid>"

# Alternative avec OVH (si vous utilisez maily.ovh)
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=redacted@example.invalid
# SMTP_PASS=votre_mot_de_passe_ovh

# Alternative avec MailHog (pour tests locaux sans envoi réel)
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="JobbingTrack <redacted@example.invalid>"

# ─────────────────────────────────────────────────────────────
# 🌐 Frontend URL (pour les liens de reset password)
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# En production :
# FRONTEND_URL=https://app.jobbingtrack.com

# ─────────────────────────────────────────────────────────────
# 🗄️ Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jobbingtrack:password@postgres:5432/jobbingtrack

# ─────────────────────────────────────────────────────────────
# 🚀 Server Configuration
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# 📊 Logging
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# 🔒 Security
# ─────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
