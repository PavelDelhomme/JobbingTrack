# ============================================
# CONFIGURATION PRISMA - EXEMPLE
# ============================================
# Copier ce fichier vers .env et adapter les valeurs

# Base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

# Pour exécution depuis l'hôte (npm run migrate depuis votre terminal)
DATABASE_URL="postgresql://jobbingtrack:jobbingtrack123@localhost:5432/jobbingtrack?schema=public"

# Pour exécution dans Docker (depuis un conteneur)
# DATABASE_URL="postgresql://jobbingtrack:jobbingtrack123@postgres:5432/jobbingtrack?schema=public"

# ============================================
# NOTES
# ============================================
# - Utilisez localhost pour exécuter Prisma depuis votre machine
# - Utilisez postgres (nom du conteneur) pour exécution dans Docker
# - Les scripts automatisés gèrent cela automatiquement
# - Ne commitez JAMAIS le fichier .env dans git
