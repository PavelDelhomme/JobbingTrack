// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SecurityLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  level        String   @db.VarChar(20) // info, warning, error, critical
  category     String   @db.VarChar(50) // authentication, intrusion, ddos, vulnerability, etc.
  eventType    String   @db.VarChar(100) // login_attempt, suspicious_activity, etc.
  message      String   @db.Text
  sourceIP     String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  userId       String?  @db.VarChar(100)
  endpoint     String?  @db.VarChar(500)
  method       String?  @db.VarChar(10)
  statusCode   Int?
  responseTime Int? // en millisecondes
  country      String?  @db.VarChar(2)
  city         String?  @db.VarChar(100)
  riskScore    Float? // score de risque de 0 à 100
  isBlocked    Boolean  @default(false)
  blockReason  String?  @db.Text // raison du blocage si isBlocked = true
  metadata     Json? // informations supplémentaires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("security_logs")
}

model Vulnerability {
  id                String    @id @default(cuid())
  title             String    @db.VarChar(200)
  description       String    @db.Text
  severity          String    @db.VarChar(20) // low, medium, high, critical
  cveId             String?   @db.VarChar(50)
  cvssScore         Float?
  affectedComponent String    @db.VarChar(100) // nom du composant/service affecté
  status            String    @db.VarChar(20) // open, in_progress, resolved, accepted_risk
  discoveredAt      DateTime  @default(now())
  resolvedAt        DateTime?
  assignedTo        String?   @db.VarChar(100)
  remediation       String?   @db.Text
  tags              String[] // technologies, frameworks, etc.
  metadata          Json? // informations supplémentaires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vulnerabilities")
}

model IntrusionAttempt {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  sourceIP       String   @db.VarChar(45)
  country        String?  @db.VarChar(2)
  city           String?  @db.VarChar(100)
  attackType     String   @db.VarChar(50) // sql_injection, xss, brute_force, etc.
  targetEndpoint String   @db.VarChar(500)
  method         String   @db.VarChar(10)
  userAgent      String?  @db.Text
  payload        String?  @db.Text // requête malveillante
  riskScore      Float // score de risque de 0 à 100
  isBlocked      Boolean  @default(false)
  blockReason    String?  @db.VarChar(200)
  metadata       Json? // informations supplémentaires

  createdAt DateTime @default(now())

  @@map("intrusion_attempts")
}

model DDoSAttack {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  sourceIPs         String[] // liste des IPs impliquées
  countries         String[] // pays d'origine
  attackType        String   @db.VarChar(50) // volumetric, protocol, application
  targetEndpoint    String   @db.VarChar(500)
  duration          Int // durée en secondes
  totalRequests     Int // nombre total de requêtes
  requestsPerSecond Float
  isMitigated       Boolean  @default(false)
  mitigationTime    Int? // temps de mitigation en secondes
  metadata          Json? // informations supplémentaires

  createdAt DateTime @default(now())

  @@map("ddos_attacks")
}

model SecurityAlert {
  id             String    @id @default(cuid())
  timestamp      DateTime  @default(now())
  level          String    @db.VarChar(20) // low, medium, high, critical
  title          String    @db.VarChar(200)
  description    String    @db.Text
  category       String    @db.VarChar(50) // intrusion, vulnerability, ddos, etc.
  source         String    @db.VarChar(100) // IP, user, service
  isAcknowledged Boolean   @default(false)
  acknowledgedBy String?   @db.VarChar(100)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  metadata       Json? // informations supplémentaires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("security_alerts")
}

model SecurityMetric {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  metricType String   @db.VarChar(50) // intrusion_attempts, ddos_attacks, vulnerabilities, etc.
  value      Float
  unit       String   @db.VarChar(20) // count, percentage, score, etc.
  period     String   @db.VarChar(20) // hour, day, week, month
  metadata   Json? // informations supplémentaires

  createdAt DateTime @default(now())

  @@map("security_metrics")
}

model FirewallRule {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  sourceIp      String?  @db.VarChar(45) // IP source (CIDR)
  destPort      Int?     // Port destination
  protocol      String   @db.VarChar(10) // TCP, UDP, ICMP
  action        String   @db.VarChar(10) // ALLOW, DENY, REJECT
  priority      Int      @default(100)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("firewall_rules")
}

model NetworkThreat {
  id            String   @id @default(cuid())
  threatType    String   @db.VarChar(50) // SYN_FLOOD, PORT_SCAN, BRUTE_FORCE, etc.
  sourceIp      String   @db.VarChar(45)
  destIp        String?  @db.VarChar(45)
  destPort      Int?
  severity      String   @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  detectedAt    DateTime @default(now())
  blocked       Boolean  @default(false)
  metadata      Json?    // Détails supplémentaires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("network_threats")
}

model NetworkConnection {
  id            String   @id @default(cuid())
  sourceIp      String   @db.VarChar(45)
  destIp        String   @db.VarChar(45)
  sourcePort    Int
  destPort      Int
  protocol      String   @db.VarChar(10)
  state         String   @db.VarChar(20) // ESTABLISHED, SYN_SENT, etc.
  containerId   String?  @db.VarChar(100)
  containerName String?  @db.VarChar(200)
  bytesRx       BigInt   @default(0)
  bytesTx       BigInt   @default(0)
  packetsRx     Int      @default(0)
  packetsTx     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("network_connections")
}
