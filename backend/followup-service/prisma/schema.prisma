generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === RELANCES ===
model FollowUp {
  id              String   @id @default(cuid())
  userId          String
  applicationId   String   // Lié à une candidature
  contactId       String?  // Lié à un contact (optionnel)
  
  // Type et planification
  type            FollowUpType
  platform        FollowupPlatform
  status          FollowUpStatus @default(PENDING)

  // Génération automatique (au lieu de AUTO_GENERATED)
  isAutoGenerated Boolean   @default(false)
  triggerReason   String?   // "7_days_no_response", "post_interview", etc...

  scheduledDate   DateTime
  sentAt          DateTime?
  completed       Boolean  @default(false)
  completedAt     DateTime?
  
  // Contenu de la relance
  subject         String
  message         String?
  response        String?
  responseType    ResponseType?  // NEGATIVE, INTERVIEW_OFFER, POSITIVE, etc...
  
  // Résultat et prochaine action
  outcome         String?
  nextAction      String?
  notes           String?
  
  // Métadonnées BaseEntity
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  archivedAt      DateTime?
  isDeleted       Boolean  @default(false)
  isArchived      Boolean  @default(false)
  syncHash        String   @default("")
  entityHash      String   @default("")
  
  @@map("followups")
}

enum FollowUpType {
  EMAIL             // Email de relance
  PHONE_CALL        // Téléphonique
  LINKEDIN_MESSAGE  // Message LinkedIn
  IN_PERSON         // "SUR PLACE"
  SMS               // Par SMS
  THANK_YOU_EMAIL   // Mail de remerciement post-entretien
}

enum FollowUpStatus {
  PENDING   // En attente d'envoi
  SCHEDULED // Programmée
  SENT // Envoyée
  RESPONDED // Réponse recue
  NO_RESPONSE // Pas de réponse
  TIMEOUT   // Délai dépassé (à relancer à nouveau)
  CANCELLED // Annulée
}

enum ResponseType {
  NEGATIVE          // Refus de candidature
  INTERVIEW_OFFER   // Proposition d'entretien
  POSITIVE          // Réponse positive
  REQUEST_INFO      // Demande d'information
  ON_HOLD           // Mise en attente
  OTHER
}