generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === CANDIDATURES SEULEMENT ===
model Application {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  
  // Informations principales
  title           String
  position        String
  description     String?
  location        String?
  salary          String?
  jobUrl          String?
  
  // Type et statut
  type            JobType  @default(FULL_TIME)
  status          ApplicationStatus @default(DRAFT)
  
  // Dates importantes
  applicationDate DateTime?
  appliedAt       DateTime?
  
  // Plateforme et source
  platform        String?  // LinkedIn, Indeed, etc.
  source          String?
  notes           String?
  
  // Références vers types (comme ton système de références)
  platformRefId       String?
  contractTypeRefId   String?
  typeRefId          String?
  statusRefId        String?
  
  // Métadonnées BaseEntity
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  archivedAt      DateTime?
  isDeleted       Boolean  @default(false)
  isArchived      Boolean  @default(false)
  syncHash        String   @default("")
  entityHash      String   @default("")
  

  // Gestion états automatiques
  lastStatusChange    DateTime @default(now())
  statusReason        String?  // Raison du changement d'état
  autoFollowUpDate    DateTime? // Date de relance automatique
  daysWithoutResponse Int      @default(0)
  
  // Métadonnées pour transitions
  statusHistory       Json[]   @default([]) // Historique des changements
  nextAction          String?  // Prochaine action recommandée
  priority            Priority @default(MEDIUM)

  @@map("applications")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  DRAFT
  SENT
  IN_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
  WITHDRAWN
  NO_RESPONSE
  PENDING_FOLLOWUP // A Relancer
  FOLLOWUP_SENT // Relance envoyé
  FOLLOWUP_RESPONDED // Réponse recu après relance
  PENDING_INTERVIEW // Etat en attente d'une interviwe
  STALE // Ancienne candidature
  
}
