generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === CANDIDATURES SEULEMENT ===
model Application {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  
  // Informations principales
  title           String
  position        String
  description     String?
  location        String?
  salary          String?
  jobUrl          String?
  
  // Type et statut
  type            JobType  @default(FULL_TIME)
  status          ApplicationStatus @default(DRAFT)
  
  // Dates importantes
  applicationDate DateTime?
  appliedAt       DateTime?
  
  // Plateforme et source
  source          String?
  notes           String?
  
  // Références vers types (comme ton système de références)
  platformRefId       String?
  contractTypeRefId   String?
  typeRefId          String?
  statusRefId        String?
  
  // Référence personnallisable ?
  platformId      String?
  contractTypeId  String?

  // Relations
  platform            ApplicationPlatform? @relation(fields: [platformId], references: [id])
  contractType        ContractType?        @relation(fields: [contractTypeId], references: [id])

  // Métadonnées BaseEntity
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  archivedAt      DateTime?
  isDeleted       Boolean  @default(false)
  isArchived      Boolean  @default(false)
  syncHash        String   @default("")
  entityHash      String   @default("")
  

  // Gestion états automatiques
  lastStatusChange    DateTime @default(now())
  statusReason        String?  // Raison du changement d'état
  autoFollowUpDate    DateTime? // Date de relance automatique
  daysWithoutResponse Int      @default(0)
  expectedResponseDate DateTime?


  // Métadonnées pour transitions
  statusHistory       Json[]   @default([]) // Historique des changements
  nextAction          String?  // Prochaine action recommandée
  priority            Priority @default(MEDIUM)

  @@map("applications")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  // Etat de base
  DRAFT
  SENT
  IN_REVIEW

  // Etats de relance
  PENDING_FOLLOWUP // "A relancer" (candidature ancienne sans réponse)
  FOLLOWUP_SENT // "Relance envoyé"
  AWAITING_FOLLOWUP_RESPONSE // "En attente de réponse à la relance"
  FOLLOWUP_TIMEOUT // "Pas de réponse après relance" (relancer à nouveau)
  FOLLOWUP_RESPONDED // Réponse recu après relance
  
  // Etats d'entretien
  INTERVIEW_SCHEDULED
  INTERVIEWED // Entretien confirmer
  AWAITING_INTERVIEW // En attente d'entretien
  INTERVIEW_COMPLETED // Entretien passé
  POST_INTERVIEW_FOLLOWUP // Mail de remerciement envoyé après entretien
  AWAITING_INTERVIEW_FEEDBACK // EN attente de retour après entretien

  // Etats finaux
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
  WITHDRAWN
  NO_RESPONSE

  // Etat spéciaux
  ON_HOLD // En pause temporaire
  EXPIRED // Candidature trop ancienne  
}


model ApplicationPlatform {
  id              String   @id @default(cuid())
  userId          String?   // Utilisateur qui a créé la plateforme || null = plateforme système
  name            String   // "LinkedIn", "HelloWork", etc.
  url             String?  // URL de la plateforme
  isDefault       Boolean  @default(false) // Plateforme par défaut du système
  isActive        Boolean  @default(true)
  
  // Métadonnées
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  applications    Application[] // Candidatures utilisant cette plateforme
  
  @@map("application_platforms")
}


model ContractType {
  id              String   @id @default(cuid())
  userId          String?  // null = type système, sinon utilisateur spécifique
  name            String   // "CDI", "CDD", "Freelance", etc.
  description     String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  
  // Métadonnées
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  applications    Application[] // Candidatures avec ce type de contrat
  
  @@map("contract_types")
}