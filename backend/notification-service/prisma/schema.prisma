// ✅ NOUVEAU - Modèle Notification
model Notification {
  id          String   @id @default(cuid())
  userId      String?
  type        String
  title       String
  message     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}

// ✅ NOUVEAU - Modèle Email Log
model EmailLog {
  id          String   @id @default(cuid())
  userId      String?
  to          String
  subject     String
  body        String?
  status      String   @default("PENDING")
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@map("email_logs")
}
  

// ENUMS
enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}
