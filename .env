# Configuration de base
NODE_ENV=development

# Configuration de la base de données
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=jobbingtrack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Configuration Admin
ADMIN_EMAIL=admin@jobbingtrack.com
ADMIN_PASSWORD=password123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=JobbingTrack

# Configuration Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Configuration JWT
JWT_SECRET=your-secret-key-change-in-production-2025
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Configuration de l'API
API_PORT=3000
FRONTEND_URL=http://localhost:8080

# Configuration des services
AUTH_SERVICE_PORT=3001
DASHBOARD_SERVICE_PORT=3007

# Configuration des métriques
METRICS_AGGREGATOR_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3003
GRAFANA_ADMIN_PASSWORD=password123
