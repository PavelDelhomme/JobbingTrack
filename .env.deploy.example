# Variables déploiement local → VPS (copier vers .env à la racine, ne pas committer)
# Guide : DEPLOY.md

# --- URLs publiques ---
DEPLOY_URL=https://jobbingtrack.example.com
API_BASE_URL=https://api.jobbingtrack.example.com
PREPROD_DEPLOY_URL=https://preprod.jobbingtrack.example.com
PREPROD_API_URL=https://api-preprod.jobbingtrack.example.com

# --- Portainer CE (Access Token gratuit — alternative aux webhooks Pro) ---
PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=ptr_xxxxxxxx
# Stack préprod (branche dev, IMAGE_TAG=dev)
PORTAINER_STACK_NAME_PREPROD=jobbingtrack-preprod
# Stack prod (branche main, IMAGE_TAG=latest)
PORTAINER_STACK_NAME_PROD=jobbingtrack-prod
# Raccourci utilisé par redeploy-vps.sh (preprod par défaut)
PORTAINER_STACK_NAME=jobbingtrack-preprod
PORTAINER_STACK_ID=
PORTAINER_ENDPOINT_ID=1

# --- SSH fallback ---
DEPLOY_SSH=user@vps-ip
# Redeploy stack Git Portainer via SSH (docker compose pull/up si stack locale)
DEPLOY_SSH_CMD=

# --- CI / attente build GHCR ---
DEPLOY_WAIT_BUILD=1
DEPLOY_IMAGE_WAIT_SECS=180
GITHUB_REPO=PavelDelhomme/JobbingTrack

# --- Images GHCR ---
IMAGE_REGISTRY=ghcr.io/paveldelhomme
IMAGE_TAG=dev

# --- Admin (upload APK distant) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_TOKEN=

# --- Mobile publish ---
MOBILE_RELEASE_CHANNEL=dev
MOBILE_RELEASE_NOTES=Publication depuis publish-apk-remote.sh

# --- Garde-fou admin deploy ---
APP_ENV=local
ALLOW_REMOTE_ADMIN_DEPLOY=0
