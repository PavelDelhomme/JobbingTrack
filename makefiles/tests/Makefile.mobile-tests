# Makefile pour Tests Mobile Playwright - JobbingTrack
# Tests E2E complets pour l'application mobile

.PHONY: help test-mobile test-mobile-all test-mobile-auth test-mobile-applications \
	test-mobile-contacts test-mobile-calls test-mobile-interviews test-mobile-followups \
	test-mobile-notifications test-mobile-ui test-mobile-debug test-mobile-report \
	test-mobile-install test-mobile-devices test-mobile-interactive

# Configuration
FRONTEND_DIR = frontend
MOBILE_TEST_DIR = $(FRONTEND_DIR)/tests/e2e/mobile
MOBILE_CONFIG = $(FRONTEND_DIR)/playwright.mobile.config.ts
FRONTEND_URL ?= http://localhost:5003
API_URL ?= http://localhost:5002

# Couleurs
CYAN = \033[0;36m
GREEN = \033[0;32m
YELLOW = \033[1;33m
RED = \033[0;31m
NC = \033[0m # No Color

help-mobile: ## Affiche l'aide pour les tests mobile
	@echo "$(CYAN)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━$(NC)"
	@echo "$(CYAN)📱 TESTS MOBILE - JobbingTrack$(NC)"
	@echo "$(CYAN)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━$(NC)"
	@echo ""
	@echo "$(GREEN)Commandes disponibles:$(NC)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' makefiles/tests/Makefile.mobile-tests | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(YELLOW)%-30s$(NC) %s\n", $$1, $$2}'
	@echo ""

check-services-mobile: ## Vérifie que les services sont démarrés pour les tests mobile
	@echo "$(CYAN)🔍 Vérification des services...$(NC)"
	@curl -s $(FRONTEND_URL) > /dev/null 2>&1 && echo "$(GREEN)✅ Frontend accessible$(NC)" || echo "$(RED)❌ Frontend non accessible sur $(FRONTEND_URL)$(NC)"
	@curl -s $(API_URL)/health > /dev/null 2>&1 && echo "$(GREEN)✅ API Gateway accessible$(NC)" || echo "$(RED)❌ API Gateway non accessible sur $(API_URL)$(NC)"

test-mobile-install: ## Installe Playwright et les navigateurs pour les tests mobile
	@echo "$(CYAN)📦 Installation de Playwright...$(NC)"
	@cd $(FRONTEND_DIR) && npm install @playwright/test --save-dev --legacy-peer-deps || true
	@cd $(FRONTEND_DIR) && npx playwright install chromium
	@echo "$(GREEN)✅ Playwright installé$(NC)"

test-mobile: check-services-mobile ## Lance tous les tests mobile (iPhone 13 Pro)
	@echo "$(CYAN)🧪 Lancement des tests mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-all: check-services-mobile ## Lance tous les tests mobile sur tous les appareils
	@echo "$(CYAN)🧪 Lancement des tests mobile sur tous les appareils...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--reporter=list

test-mobile-auth: check-services-mobile ## Tests d'authentification mobile
	@echo "$(CYAN)🔐 Tests d'authentification mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-auth.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-applications: check-services-mobile ## Tests de gestion des candidatures mobile
	@echo "$(CYAN)📋 Tests candidatures mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-applications.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-contacts: check-services-mobile ## Tests de gestion des contacts mobile
	@echo "$(CYAN)👥 Tests contacts mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-contacts.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-calls: check-services-mobile ## Tests de gestion des appels mobile
	@echo "$(CYAN)📞 Tests appels mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-calls.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-interviews: check-services-mobile ## Tests de gestion des entretiens mobile
	@echo "$(CYAN)📅 Tests entretiens mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-interviews.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-followups: check-services-mobile ## Tests de gestion des relances mobile
	@echo "$(CYAN)🔔 Tests relances mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-followups.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-notifications: check-services-mobile ## Tests de notifications mobile
	@echo "$(CYAN)🔔 Tests notifications mobile...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-notifications.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list

test-mobile-devices: check-services-mobile ## Lance les tests sur différents appareils
	@echo "$(CYAN)📱 Tests sur différents appareils...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-complete-journey.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--reporter=list

test-mobile-ui: check-services-mobile ## Mode UI interactif Playwright
	@echo "$(CYAN)🎬 Mode UI interactif...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--ui

test-mobile-debug: check-services-mobile ## Mode debug step-by-step
	@echo "$(CYAN)🐛 Mode debug...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--debug

test-mobile-report: ## Ouvre le rapport HTML des tests mobile
	@echo "$(CYAN)📊 Ouverture du rapport HTML...$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright show-report playwright-report-mobile || \
		echo "$(RED)❌ Aucun rapport trouvé. Lancez d'abord les tests.$(NC)"

test-mobile-interactive: ## Menu interactif pour les tests mobile
	@cd $(FRONTEND_DIR) && node scripts/test-mobile-cli.js || \
		./scripts/test-mobile-interactive.sh

