test-mobile-devices: check-services-mobile ## Lance les tests sur différents appareils (dans conteneur Docker)
	@echo "$(CYAN)📱 Tests sur différents appareils (dans conteneur Docker)...$(NC)"
	@docker exec -w /app $(DOCKER_CONTAINER) npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
