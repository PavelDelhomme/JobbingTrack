		(cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
			--config=$(MOBILE_CONFIG) \
			--reporter=list,html,json)

test-mobile-ui: check-services-mobile ## Mode UI interactif Playwright (nécessite affichage local)
	@echo "$(CYAN)🎨 Mode UI interactif...$(NC)"
	@echo "$(YELLOW)⚠️  Mode UI nécessite un affichage, exécution locale recommandée$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--ui

test-mobile-debug: check-services-mobile ## Mode debug step-by-step (nécessite affichage local)
	@echo "$(CYAN)🐛 Mode debug...$(NC)"
	@echo "$(YELLOW)⚠️  Mode debug nécessite un affichage, exécution locale recommandée$(NC)"
	@cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--debug

test-mobile-report: ## Ouvre le rapport HTML des tests mobile (sur port 5004)
	@./scripts/show-mobile-report.sh

test-mobile-interactive: ## Menu interactif pour les tests mobile
	@cd $(FRONTEND_DIR) && node scripts/test-mobile-cli.js || \
		./scripts/test-mobile-interactive.sh
