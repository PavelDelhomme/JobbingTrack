# Makefile pour Tests Mobile Playwright - JobbingTrack
# Tests E2E complets pour l'application mobile

.PHONY: help test-mobile test-mobile-all test-mobile-auth test-mobile-applications \
	test-mobile-contacts test-mobile-calls test-mobile-interviews test-mobile-followups \
	test-mobile-notifications test-mobile-ui test-mobile-debug test-mobile-report \
	test-mobile-install test-mobile-devices test-mobile-interactive

# Configuration
FRONTEND_DIR := frontend
MOBILE_TEST_DIR := tests/e2e/mobile
MOBILE_CONFIG := playwright.mobile.config.ts
API_URL := http://localhost:5002
FRONTEND_URL := http://localhost:5003
DOCKER_CONTAINER := jobbingtrack-frontend

# Couleurs
GREEN = \033[0;32m
YELLOW = \033[1;33m
CYAN = \033[0;36m
RED = \033[0;31m
NC = \033[0m # No Color

help-mobile: ## Affiche l'aide pour les tests mobile
	@echo "$(CYAN)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━$(NC)"
	@echo "$(CYAN)📱 TESTS MOBILE - JobbingTrack$(NC)"
	@echo "$(CYAN)━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━$(NC)"
	@echo ""
	@echo "$(GREEN)Commandes disponibles:$(NC)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(YELLOW)%-30s$(NC) %s\n", $$1, $$2}'
	@echo ""

check-services-mobile: ## Vérifie que les services sont démarrés pour les tests mobile
	@echo "$(CYAN)🔍 Vérification des services...$(NC)"
	@curl -s $(FRONTEND_URL) > /dev/null 2>&1 && echo "$(GREEN)✅ Frontend accessible$(NC)" || echo "$(RED)❌ Frontend non accessible sur $(FRONTEND_URL)$(NC)"
	@curl -s $(API_URL)/health > /dev/null 2>&1 && echo "$(GREEN)✅ API Gateway accessible$(NC)" || echo "$(RED)❌ API Gateway non accessible sur $(API_URL)$(NC)"
	@echo "$(CYAN)🔍 Vérification Playwright (dans conteneur Docker)...$(NC)"
	@docker exec $(DOCKER_CONTAINER) npx playwright --version > /dev/null 2>&1 && echo "$(GREEN)✅ Playwright installé dans le conteneur$(NC)" || echo "$(YELLOW)⚠️  Playwright non installé dans le conteneur (tests utiliseront le conteneur)$(NC)"

test-mobile-install: ## Installe Playwright et les navigateurs (utilise scripts/setup-playwright.sh)
	@echo "$(CYAN)📦 Installation Playwright via script spécialisé...$(NC)"
	@echo "$(YELLOW)💡 Utilisation de scripts/setup-playwright.sh pour l'installation${NC}"
	@./scripts/setup-playwright.sh

test-mobile: check-services-mobile ## Lance tous les tests mobile (iPhone 13 Pro) dans le conteneur Docker
	@echo "$(CYAN)🧪 Lancement des tests mobile (dans conteneur Docker)...$(NC)"
	@echo "$(YELLOW)💡 Les tests s'exécutent dans le conteneur $(DOCKER_CONTAINER)$(NC)"
	@docker exec -w /app $(DOCKER_CONTAINER) npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list,html,json || \
		(echo "$(YELLOW)⚠️  Tentative d'exécution locale...$(NC)" && \
		cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
			--config=$(MOBILE_CONFIG) \
			--project="iPhone 13 Pro" \
			--reporter=list,html,json)

test-mobile-all: check-services-mobile ## Lance tous les tests mobile sur tous les appareils (dans conteneur Docker)
	@echo "$(CYAN)🧪 Lancement des tests mobile sur tous les appareils (dans conteneur Docker)...$(NC)"
	@docker exec -w /app $(DOCKER_CONTAINER) npx playwright test $(MOBILE_TEST_DIR) \
		--config=$(MOBILE_CONFIG) \
		--reporter=list,html,json || \
		(echo "$(YELLOW)⚠️  Tentative d'exécution locale...$(NC)" && \
		cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR) \
			--config=$(MOBILE_CONFIG) \
			--reporter=list,html,json)

test-mobile-auth: check-services-mobile ## Tests d'authentification mobile (dans conteneur Docker)
	@echo "$(CYAN)🔐 Tests authentification mobile (dans conteneur Docker)...$(NC)"
	@docker exec -w /app $(DOCKER_CONTAINER) npx playwright test $(MOBILE_TEST_DIR)/mobile-auth.spec.ts \
		--config=$(MOBILE_CONFIG) \
		--project="iPhone 13 Pro" \
		--reporter=list,html,json || \
		(cd $(FRONTEND_DIR) && npx playwright test $(MOBILE_TEST_DIR)/mobile-auth.spec.ts \
			--config=$(MOBILE_CONFIG) \
			--project="iPhone 13 Pro" \
			--reporter=list,html,json)

