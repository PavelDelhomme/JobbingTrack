# ============================================================================
# Makefile Production - JobbingTrack
# ============================================================================
# Commandes pour déployer et gérer JobbingTrack en production
# ============================================================================

# Inclure les fonctions et variables communes
include makefiles/shared/common.mk

# Couleurs
GREEN := \033[0;32m
RED := \033[0;31m
YELLOW := \033[1;33m
BLUE := \033[0;34m
CYAN := \033[0;36m
NC := \033[0m

.PHONY: help deploy stop restart logs status backup restore

# ============================================================================
# AIDE
# ============================================================================

help: ## Afficher l'aide pour les commandes de production
	@echo ""
	@echo "$(BLUE)🚀 JobbingTrack - Commandes Production$(NC)"
	@echo ""
	@echo "$(CYAN)📦 DÉPLOIEMENT:$(NC)"
	@echo "  $(GREEN)make deploy$(NC)      - Déployer en production"
	@echo "  $(GREEN)make stop$(NC)        - Arrêter la production"
	@echo "  $(GREEN)make restart$(NC)     - Redémarrer la production"
	@echo ""
	@echo "$(CYAN)📊 SURVEILLANCE:$(NC)"
	@echo "  $(BLUE)make logs$(NC)        - Voir les logs en temps réel"
	@echo "  $(BLUE)make status$(NC)      - État des services"
	@echo "  $(BLUE)make health$(NC)      - Vérifier la santé"
	@echo ""
	@echo "$(CYAN)💾 SAUVEGARDES:$(NC)"
	@echo "  $(YELLOW)make backup$(NC)      - Créer une sauvegarde"
	@echo "  $(YELLOW)make restore$(NC)     - Restaurer une sauvegarde"
	@echo ""
	@echo "$(CYAN)🔧 MAINTENANCE:$(NC)"
	@echo "  $(YELLOW)make update$(NC)      - Mettre à jour l'application"
	@echo "  $(YELLOW)make migrate$(NC)     - Appliquer les migrations DB"
	@echo "  $(RED)make clean$(NC)       - Nettoyer (⚠️ DANGER)"
	@echo ""

# ============================================================================
# DÉPLOIEMENT
# ============================================================================

deploy: ## Déployer en production
	@echo "$(GREEN)🚀 Déploiement de JobbingTrack en production...$(NC)"
	@if [ ! -f production/.env ]; then \
		echo "$(RED)❌ Fichier production/.env manquant$(NC)"; \
		echo "$(YELLOW)💡 Copiez production/env.production.example vers production/.env$(NC)"; \
		exit 1; \
	fi
	@echo "$(BLUE)📦 Construction des images...$(NC)"
	@cd production && $(call docker_compose, -f docker-compose.production.yml build --parallel)
	@echo "$(BLUE)🚀 Démarrage des services...$(NC)"
	@cd production && $(call docker_compose, -f docker-compose.production.yml up -d)
	@echo "$(GREEN)✅ JobbingTrack déployé en production$(NC)"
	@echo ""
	@echo "$(CYAN)🌐 Accès:$(NC)"
	@echo "  Frontend: $(GREEN)https://$$DOMAIN$(NC)"
	@echo ""

stop: ## Arrêter la production
	@echo "$(RED)🛑 Arrêt de la production...$(NC)"
	@cd production && $(call docker_compose, -f docker-compose.production.yml down)
	@echo "$(GREEN)✅ Production arrêtée$(NC)"

restart: ## Redémarrer la production
	@echo "$(YELLOW)🔄 Redémarrage de la production...$(NC)"
	@cd production && $(call docker_compose, -f docker-compose.production.yml restart)
	@echo "$(GREEN)✅ Production redémarrée$(NC)"

# ============================================================================
# SURVEILLANCE
# ============================================================================

logs: ## Logs en temps réel
	@cd production && $(call docker_compose, -f docker-compose.production.yml logs -f)

status: ## État des services
	@echo "$(BLUE)📊 Statut des services de production:$(NC)"
	@cd production && $(call docker_compose, -f docker-compose.production.yml ps)

health: ## Vérifier la santé des services
	@echo "$(GREEN)💚 Vérification de la santé...$(NC)"
	@curl -s http://localhost:3000/health || echo "$(RED)❌ API Gateway non accessible$(NC)"

# ============================================================================
# SAUVEGARDES
# ============================================================================

backup: ## Créer une sauvegarde complète
	@echo "$(BLUE)💾 Création d'une sauvegarde...$(NC)"
	@BACKUP_DIR="backups/prod_$$(date +%Y%m%d_%H%M%S)"; \
	mkdir -p "$$BACKUP_DIR"; \
	echo "$(YELLOW)📦 Sauvegarde de PostgreSQL...$(NC)"; \
	docker exec jobbingtrack-postgres-prod pg_dump -U jobbingtrack jobbingtrack | gzip > "$$BACKUP_DIR/database.sql.gz"; \
	echo "$(GREEN)✅ Sauvegarde créée: $$BACKUP_DIR/$(NC)"

restore: ## Restaurer une sauvegarde
	@echo "$(RED)⚠️  RESTAURATION DE SAUVEGARDE$(NC)"
	@echo "$(YELLOW)Entrez le chemin de la sauvegarde (ex: backups/prod_20250101_120000/database.sql.gz):$(NC)"
	@read backup_file; \
	if [ -f "$$backup_file" ]; then \
		gunzip -c "$$backup_file" | docker exec -i jobbingtrack-postgres-prod psql -U jobbingtrack -d jobbingtrack; \
		echo "$(GREEN)✅ Sauvegarde restaurée$(NC)"; \
	else \
		echo "$(RED)❌ Fichier de sauvegarde non trouvé$(NC)"; \
	fi

# ============================================================================
# MAINTENANCE
# ============================================================================

update: ## Mettre à jour l'application
	@echo "$(YELLOW)🔄 Mise à jour de l'application...$(NC)"
	@git pull origin main
	@cd production && $(call docker_compose, -f docker-compose.production.yml build --no-cache)
	@cd production && $(call docker_compose, -f docker-compose.production.yml up -d)
	@echo "$(GREEN)✅ Application mise à jour$(NC)"

migrate: ## Appliquer les migrations de base de données
	@echo "$(BLUE)🗄️  Application des migrations...$(NC)"
	@docker exec jobbingtrack-auth-service-prod npx prisma migrate deploy
	@echo "$(GREEN)✅ Migrations appliquées$(NC)"

clean: ## Nettoyer complètement (⚠️ DANGER - SUPPRIME LES DONNÉES)
	@echo "$(RED)⚠️  ATTENTION: Cette action supprimera TOUTES les données$(NC)"
	@echo "$(YELLOW)Tapez 'YES' pour confirmer:$(NC)"
	@read confirm; \
	if [ "$$confirm" = "YES" ]; then \
		cd production && docker compose -f docker-compose.production.yml down -v; \
		echo "$(GREEN)✅ Nettoyage terminé$(NC)"; \
	else \
		echo "$(BLUE)ℹ️  Annulé$(NC)"; \
	fi

