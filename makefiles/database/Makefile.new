# ============================================
# MAKEFILE - NOUVELLE ARCHITECTURE DATABASE
# ============================================
# Commandes pour gérer la nouvelle architecture avec schéma Prisma partagé

.PHONY: db-migrate db-validate db-deploy db-studio db-reset db-status db-backup

# ============================================
# MIGRATION
# ============================================

## Exécuter les migrations Prisma dans Docker
db-migrate:
	@echo "🚀 Exécution des migrations Prisma..."
	@bash scripts/run-prisma-migrations.sh

## Valider l'architecture après migration
db-validate:
	@echo "🧪 Validation de l'architecture..."
	@bash scripts/validate-new-architecture.sh

## Déploiement complet (migrations + services + tests)
db-deploy:
	@echo "🚀 Déploiement complet de la nouvelle architecture..."
	@bash scripts/deploy-new-database-architecture.sh

## Mettre à jour les imports Prisma dans les services
db-update-imports:
	@echo "🔄 Mise à jour des imports Prisma..."
	@bash scripts/update-prisma-imports.sh

# ============================================
# OUTILS
# ============================================

## Ouvrir Prisma Studio (interface graphique)
db-studio:
	@echo "🎨 Ouverture de Prisma Studio..."
	@echo "📍 URL: http://localhost:5555"
	@cd backend/prisma && npm run studio

## Générer le client Prisma
db-generate:
	@echo "🔧 Génération du client Prisma..."
	@cd backend/prisma && npm run generate

## Formater le schéma Prisma
db-format:
	@echo "✨ Formatage du schéma Prisma..."
	@cd backend/prisma && npx prisma format

## Valider le schéma Prisma
db-schema-validate:
	@echo "✅ Validation du schéma..."
	@cd backend/prisma && npx prisma validate

# ============================================
# SEED
# ============================================

## Exécuter le seed (valeurs prédéfinies)
db-seed:
	@echo "🌱 Insertion des valeurs prédéfinies..."
	@docker run --rm -i \
		--network $$(docker network ls | grep jobbingtrack | awk '{print $$2}' | head -n 1) \
		-v $$(pwd)/backend/prisma:/app \
		-w /app \
		-e DATABASE_URL="postgresql://jobbingtrack:jobbingtrack123@postgres:5432/jobbingtrack?schema=public" \
		node:20-alpine \
		sh -c "npm install --silent && node seed.js"

# ============================================
# STATUS & INFO
# ============================================

## Afficher le statut de la base de données
db-status:
	@echo "📊 Statut de la base de données"
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo ""
	@echo "🐘 PostgreSQL:"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -c "SELECT version();" 2>/dev/null || echo "  ❌ Non accessible"
	@echo ""
	@echo "📊 Tables:"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -t -c "\dt" 2>/dev/null | wc -l | xargs echo "  Tables créées:" || echo "  ❌ Erreur"
	@echo ""
	@echo "🔗 Foreign Keys:"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -t -c "SELECT COUNT(*) FROM information_schema.table_constraints WHERE constraint_type = 'FOREIGN KEY';" 2>/dev/null | xargs echo "  Relations:" || echo "  ❌ Erreur"
	@echo ""
	@echo "📦 Valeurs prédéfinies:"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -t -c "SELECT COUNT(*) FROM \"Platform\" WHERE \"isPredefined\" = true;" 2>/dev/null | xargs echo "  Plateformes:" || echo "  N/A"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -t -c "SELECT COUNT(*) FROM \"FollowUpType\" WHERE \"isPredefined\" = true;" 2>/dev/null | xargs echo "  Types relance:" || echo "  N/A"
	@docker exec jobbingtrack-postgres psql -U jobbingtrack -d jobbingtrack -t -c "SELECT COUNT(*) FROM \"InterviewType\" WHERE \"isPredefined\" = true;" 2>/dev/null | xargs echo "  Types entretien:" || echo "  N/A"

## Afficher les infos du schéma Prisma
db-info:
	@echo "📄 Informations sur le schéma Prisma"
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo ""
	@echo "📍 Emplacement: backend/prisma/schema.prisma"
	@echo "📏 Taille:" $$(wc -l < backend/prisma/schema.prisma) "lignes"
	@echo ""
	@echo "📊 Modèles:"
	@grep "^model " backend/prisma/schema.prisma | wc -l | xargs echo "  Total:"
	@echo ""
	@echo "🎨 Enums:"
	@grep "^enum " backend/prisma/schema.prisma | wc -l | xargs echo "  Total:"

# ============================================
# BACKUP & RESTORE
# ============================================

## Créer un backup de la base de données
db-backup:
	@echo "💾 Création d'un backup..."
	@mkdir -p backups
	@docker exec jobbingtrack-postgres pg_dump -U jobbingtrack jobbingtrack > backups/backup_$$(date +%Y%m%d_%H%M%S).sql
	@echo "✅ Backup créé dans backups/"

## Restaurer depuis un backup
db-restore:
	@echo "⚠️  ATTENTION : Cela va ÉCRASER la base de données actuelle !"
	@read -p "Fichier de backup (ex: backups/backup_20231030_120000.sql): " backup; \
	if [ -f "$$backup" ]; then \
		docker exec -i jobbingtrack-postgres psql -U jobbingtrack jobbingtrack < $$backup; \
		echo "✅ Restauration terminée"; \
	else \
		echo "❌ Fichier introuvable: $$backup"; \
	fi

# ============================================
# RESET (DANGER)
# ============================================

## Reset complet de la base de données (⚠️ SUPPRIME TOUT)
db-reset:
	@echo "⚠️  ⚠️  ⚠️  DANGER ⚠️  ⚠️  ⚠️"
	@echo "Cette action va SUPPRIMER TOUTES les données de la base !"
	@echo ""
	@read -p "Taper 'yes' pour confirmer: " confirm; \
	if [ "$$confirm" = "yes" ]; then \
		echo "🗑️  Suppression de toutes les données..."; \
		docker run --rm -i \
			--network $$(docker network ls | grep jobbingtrack | awk '{print $$2}' | head -n 1) \
			-v $$(pwd)/backend/prisma:/app \
			-w /app \
			-e DATABASE_URL="postgresql://jobbingtrack:jobbingtrack123@postgres:5432/jobbingtrack?schema=public" \
			node:20-alpine \
			sh -c "npm install --silent && npx prisma migrate reset --force"; \
		echo "✅ Base réinitialisée"; \
	else \
		echo "❌ Annulé"; \
	fi

# ============================================
# AIDE
# ============================================

## Afficher l'aide
db-help:
	@echo "📚 Commandes disponibles pour la nouvelle architecture DB"
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo ""
	@echo "Migration:"
	@echo "  make db-migrate          Exécuter les migrations Prisma"
	@echo "  make db-validate         Valider l'architecture"
	@echo "  make db-deploy           Déploiement complet"
	@echo "  make db-update-imports   Mettre à jour les imports"
	@echo ""
	@echo "Outils:"
	@echo "  make db-studio           Ouvrir Prisma Studio"
	@echo "  make db-generate         Générer le client Prisma"
	@echo "  make db-format           Formater le schéma"
	@echo "  make db-schema-validate  Valider le schéma"
	@echo ""
	@echo "Seed:"
	@echo "  make db-seed             Insérer les valeurs prédéfinies"
	@echo ""
	@echo "Status:"
	@echo "  make db-status           Afficher le statut"
	@echo "  make db-info             Infos sur le schéma"
	@echo ""
	@echo "Backup:"
	@echo "  make db-backup           Créer un backup"
	@echo "  make db-restore          Restaurer un backup"
	@echo ""
	@echo "Danger:"
	@echo "  make db-reset            Reset complet (⚠️ SUPPRIME TOUT)"
	@echo ""
	@echo "📖 Documentation: MIGRATION_GUIDE.md"
