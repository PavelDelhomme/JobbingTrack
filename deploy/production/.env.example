# Exemple pour Portainer > Stacks > jobbingtrack > Environment variables
# Copier ces clés dans la stack (mode avancé). Ne jamais committer les vraies valeurs.
# Référence complète : ../../.env.example à la racine du dépôt.

# --- Images (phase CI recommandée) ---
IMAGE_REGISTRY=ghcr.io/paveldelhomme
IMAGE_TAG=dev
# build = build sur le VPS si l'image GHCR manque ; always = tirer depuis GHCR uniquement
IMAGE_PULL_POLICY=build

# --- Publication locale pour Nginx Proxy Manager ---
API_PUBLISH_HOST=127.0.0.1
API_PUBLISH_PORT=3000
FRONTEND_PUBLISH_HOST=127.0.0.1
FRONTEND_PUBLISH_PORT=3001

# --- Domaines publics (HTTPS via NPM) — jobbingtrack.com ---
STACK_SLUG=jobbingtrack-preprod
NEXT_PUBLIC_API_URL=https://api-preprod.jobbingtrack.com
NEXT_PUBLIC_API_GATEWAY_URL=https://api-preprod.jobbingtrack.com
NEXT_PUBLIC_AUTH_SERVICE_URL=https://api-preprod.jobbingtrack.com
NEXT_PUBLIC_FRONTEND_URL=https://preprod.jobbingtrack.com
FRONTEND_URL=https://preprod.jobbingtrack.com
FRONTEND_PUBLIC_URL=https://preprod.jobbingtrack.com
APP_URL=https://preprod.jobbingtrack.com
ALLOWED_ORIGINS=https://preprod.jobbingtrack.com,https://api-preprod.jobbingtrack.com

# Prod (stack jobbingtrack-prod) :
# NEXT_PUBLIC_API_URL=https://api.jobbingtrack.com
# NEXT_PUBLIC_FRONTEND_URL=https://jobbingtrack.com
# ALLOWED_ORIGINS=https://jobbingtrack.com,https://www.jobbingtrack.com,https://api.jobbingtrack.com
# STACK_SLUG=jobbingtrack-prod
# IMAGE_TAG=latest
# IMAGE_PULL_POLICY=always

# --- Base de données (conteneur postgres de la stack) ---
POSTGRES_DB=jobbingtrack
POSTGRES_USER=jobbingtrack
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SYSTEM_METRICS_TZ=UTC

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- JWT / sécurité interne ---
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
SECURITY_INTERNAL_SECRET=change-me-security-internal-secret
METRICS_API_KEY=change-me-metrics-api-key

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- SMTP production (OVH ou autre) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM=JobbingTrack <noreply@example.com>
SMTP_SECURE=false
SMTP_USE_SSL=false

# --- Proxy / WAF ---
TRUST_PROXY_HOPS=2
WAF_ENABLED=true
INTRUSION_DETECTION_ENABLED=true
INTRUSION_RELAX_HEURISTICS=false
ENABLE_CENTRAL_LOGGING=true

# --- Optionnel ---
NEXT_PUBLIC_APP_NAME=JobbingTrack
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_TZ=Europe/Paris
SECURITY_ALERT_EMAIL=admin@example.com

# --- Mises à jour mobile (OTA Android / App Store iOS) ---
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_LATEST_BUILD=1
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_MIN_BUILD=1
MOBILE_ANDROID_APK_FILENAME=jobbingtrack-1.0.0+1.apk
# Ou URL externe (GitHub Releases) à la place du fichier hébergé sur l'API :
# MOBILE_ANDROID_DOWNLOAD_URL=https://github.com/PavelDelhomme/JobbingTrack/releases/download/mobile-v1.0.0/jobbingtrack-1.0.0+1.apk
MOBILE_ANDROID_FORCE_UPDATE=false
MOBILE_ANDROID_RELEASE_NOTES=Première version
MOBILE_IOS_APP_STORE_URL=
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_LATEST_BUILD=1
MOBILE_IOS_MIN_VERSION=1.0.0
MOBILE_IOS_MIN_BUILD=0
MOBILE_IOS_FORCE_UPDATE=false
MOBILE_IOS_RELEASE_NOTES=
