# ============================================================================
# CONFIGURATION PRODUCTION - JobbingTrack
# ============================================================================
# Copiez ce fichier en .env et configurez vos valeurs
# ============================================================================

# ============================================================================
# DOMAINE ET URLs
# ============================================================================
DOMAIN=jobbingtrack.votredomaine.com
FRONTEND_URL=https://jobbingtrack.votredomaine.com
API_URL=https://api.jobbingtrack.votredomaine.com
ADMIN_URL=https://jobbingtrack.votredomaine.com/backoffice

# ============================================================================
# BASE DE DONNÉES POSTGRESQL
# ============================================================================
POSTGRES_DB=jobbingtrack
POSTGRES_USER=jobbingtrack
POSTGRES_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION_SECURISE_123!

# ============================================================================
# SÉCURITÉ JWT
# ============================================================================
# ⚠️ IMPORTANT: Générez des secrets uniques et forts pour la production
# Exemple: openssl rand -base64 64
JWT_SECRET=CHANGEZ_CE_SECRET_JWT_EN_PRODUCTION_AVEC_UNE_VALEUR_TRES_SECURISEE
JWT_REFRESH_SECRET=CHANGEZ_CE_SECRET_REFRESH_EN_PRODUCTION_AVEC_UNE_VALEUR_DIFFERENTE

# ============================================================================
# CONFIGURATION EMAIL (SMTP)
# ============================================================================
SMTP_HOST=smtp.votreserveur.com
SMTP_PORT=587
SMTP_USER=redacted@example.invalid
SMTP_PASS=VOTRE_MOT_DE_PASSE_EMAIL
SMTP_FROM=JobbingTrack <redacted@example.invalid>

# ============================================================================
# ORIGINES AUTORISÉES (CORS)
# ============================================================================
ALLOWED_ORIGINS=https://jobbingtrack.votredomaine.com,https://www.jobbingtrack.votredomaine.com

# ============================================================================
# CONFIGURATION NGINX PROXY MANAGER
# ============================================================================
# Domaines à configurer dans Nginx Proxy Manager:
# - jobbingtrack.votredomaine.com -> jobbingtrack-frontend-prod:3000
# - api.jobbingtrack.votredomaine.com -> jobbingtrack-api-gateway-prod:3000
#
# SSL: Activez Let's Encrypt pour les deux domaines
# Force SSL: Oui
# HTTP/2: Oui
# HSTS: Oui

