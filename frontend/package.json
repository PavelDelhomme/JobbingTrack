{
    "name": "jobbingtrack-frontend",
    "version": "1.0.1",
    "description": "JobbingTrack Dashboard Admin - Interface Next.js v1.0.1",
    "private": true,
    "scripts": {
        "dev": "next dev -H 0.0.0.0",
        "build": "next build",
        "start": "next start -H 0.0.0.0",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf .next node_modules/.cache",
        "test": "jest",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "test:watch": "jest --watch",
        "test:unit": "jest --testPathPattern=unit --passWithNoTests",
        "test:analytics": "jest --testPathPattern=analytics/__tests__",
        "test:analytics:validate": "./scripts/validate-analytics-page.sh",
        "test:analytics:complete": "./scripts/test-analytics-complete.sh",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test --reporter=html",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "test:e2e:full": "./scripts/test-e2e.sh",
        "test:e2e:mobile": "./scripts/test-mobile.sh",
        "test:e2e:mobile:integrated": "./scripts/test-mobile-integrated.sh",
        "test:e2e:mobile:interactive": "./scripts/test-mobile-interactive.sh",
        "test:e2e:mobile:cli": "node scripts/test-mobile-cli.js",
        "test:e2e:mobile:all": "npx playwright test tests/e2e/mobile --config=playwright.mobile.config.ts",
        "test:e2e:api": "./scripts/test-api-only.sh",
        "test:e2e:user-management": "./scripts/test-user-management.sh",
        "test:e2e:impersonation": "playwright test impersonation-tests.spec.ts",
        "test:e2e:admin": "./scripts/test-playwright-admin.sh",
        "dev:mobile": "cd ../flutter-mobile-app && flutter run -d web-server --web-port 8090",
        "test:a11y": "playwright test --grep @accessibility",
        "test:a11y:axe": "playwright test accessibility.spec.ts --reporter=json",
        "test:a11y:all": "playwright test --grep @accessibility --reporter=json",
        "test:all": "npm run test && npm run test:e2e",
        "test:ci:all": "npm run test:ci && npm run test:e2e:ci && npm run test:a11y:all",
        "perf:test": "./scripts/performance-test.sh",
        "perf:analyze": "ANALYZE=true npm run build",
        "perf:optimize": "./scripts/optimize-memory.sh"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.10.0",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@tanstack/react-query": "^5.59.13",
        "@types/node": "22.8.1",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1",
        "autoprefixer": "10.4.20",
        "axios": "^1.7.7",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "critters": "^0.0.24",
        "date-fns": "^4.1.0",
        "html2canvas": "^1.4.1",
        "js-cookie": "^3.0.5",
        "jspdf": "^2.5.2",
        "jszip": "^3.10.1",
        "lucide-react": "^0.453.0",
        "next": "14.2.15",
        "postcss": "8.4.47",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hook-form": "^7.53.2",
        "react-markdown": "^9.0.1",
        "recharts": "^2.12.7",
        "remark-gfm": "^4.0.0",
        "socket.io-client": "^4.8.1",
        "tailwind-merge": "^2.5.4",
        "tailwindcss": "3.4.14",
        "typescript": "5.6.3",
        "zod": "^3.23.8",
        "zustand": "^5.0.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.9.1",
        "@playwright/test": "^1.56.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@types/js-cookie": "^3.0.6",
        "@types/jszip": "^3.4.0",
        "@types/socket.io-client": "^1.4.36",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "axe-playwright": "^2.0.1",
        "baseline-browser-mapping": "^2.9.7",
        "eslint": "^8.57.1",
        "eslint-config-next": "^14.2.15",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.8",
        "webpack-bundle-analyzer": "^4.10.1"
    }
}
