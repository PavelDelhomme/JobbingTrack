{
  "name": "JobbingTrack - Suivi de Candidatures Professionnel",
  "short_name": "JobbingTrack",
  "description": "Plateforme complète de suivi de candidatures avec gestion des contacts, entretiens, relances et workflows automatisés",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3B82F6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/brand/jobbingtrack-logo.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-256x256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "JobbingTrack Dashboard Desktop"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "JobbingTrack Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouvelles Candidatures",
      "short_name": "Candidatures",
      "description": "Accéder rapidement aux candidatures",
      "url": "/applications",
      "icons": [
        {
          "src": "/icons/shortcut-applications.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Entretiens",
      "short_name": "Entretiens",
      "description": "Planifier et suivre les entretiens",
      "url": "/interviews",
      "icons": [
        {
          "src": "/icons/shortcut-interviews.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Relances",
      "short_name": "Relances",
      "description": "Gérer les relances et suivis",
      "url": "/followups",
      "icons": [
        {
          "src": "/icons/shortcut-followups.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Contacts",
      "short_name": "Contacts",
      "description": "Gérer les contacts et entreprises",
      "url": "/contacts",
      "icons": [
        {
          "src": "/icons/shortcut-contacts.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "com.jobbingtrack.app",
      "url": "https://play.google.com/store/apps/details?id=com.jobbingtrack.app"
    },
    {
      "platform": "itunes",
      "id": "com.jobbingtrack.app",
      "url": "https://apps.apple.com/app/jobbingtrack/id1234567890"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/contacts?email=%s"
    },
    {
      "protocol": "tel",
      "url": "/contacts?phone=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xlsx"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "/import/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/notes/new"
  }
}
